    "build": "npm run build --prefix client",
    "start": "npm run start --prefix server"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "express": "^4.21.2",
    "nodemailer": "^10.1.0",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
